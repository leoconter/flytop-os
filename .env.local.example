# ============================================================================
# Supabase — banco da plataforma (vendas do Monde, comunidade, métricas)
# Copie para .env.local; ele já está no .gitignore.
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço. SEM o prefixo NEXT_PUBLIC_ de propósito: ela ignora a RLS,
# então só pode ser usada no servidor (Server Components e scripts).
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Monde (ERP) — histórico de vendas e clientes
# ============================================================================
# Token Basic da API v3. Na plataforma ele NÃO é lido daqui: quem chama o Monde
# é a Edge Function, que usa o secret do Supabase (supabase secrets set
# MONDE_API_TOKEN=...). Esta linha serve só para testes locais de sondagem.
MONDE_API_TOKEN=

# ============================================================================
# Meta (Facebook/Instagram) — métricas da tela Social (e depois Ads)
# ============================================================================

# Token de acesso do app Meta. Ideal: token de usuário do sistema criado no
# Gerenciador de Negócios (Configurações → Usuários do sistema) com as
# permissões: instagram_basic, instagram_manage_insights, pages_show_list,
# pages_read_engagement, business_management (e ads_read para a fase de Ads).
META_ACCESS_TOKEN=

# ID da conta profissional do Instagram. Para descobrir, preencha o token
# acima e rode:  node scripts/meta-discover.mjs
META_IG_USER_ID=

# Conta de anúncios (formato act_<id>) — tela de Métricas de Ads.
# O mesmo script acima lista as contas disponíveis para o token.
META_AD_ACCOUNT_ID=

# Opcional — versão da Graph API (padrão v23.0)
# META_GRAPH_VERSION=v23.0
